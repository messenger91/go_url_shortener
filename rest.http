@hostname = localhost
@port = 8082
@host = http://{{hostname}}:{{port}}
@contentType = application/json
@authorization = Basic admin:admin


### Create alias
POST {{host}}/url
Content-Type: {{contentType}}
Authorization: {{authorization}}

{
  "URL": "https://github.com/messenger91"
}

### Get alias and redirect to url
GET http://localhost:8082/IeDpBFZv
### Delete alias
DELETE {{host}}/url/IeDpBFZv
Authorization: {{authorization}}

### Get alias stats
GET {{host}}/url/IeDpBFZv/stats
Authorization: {{authorization}}

### Create temporary alias (expires in 1 hour)
POST {{host}}/url
Content-Type: {{contentType}}
Authorization: {{authorization}}

{
  "url": "https://github.com/messenger91",
  "ttl_seconds": 3600
}

### Login (sets session cookie)
POST {{host}}/login
Content-Type: {{contentType}}

{
  "user": "admin",
  "password": "admin"
}

### List all links
GET {{host}}/url
Authorization: {{authorization}}

### Update a link
PUT {{host}}/url/mylink
Content-Type: {{contentType}}
Authorization: {{authorization}}

{
  "url": "https://github.com/messenger91",
  "ttl_seconds": 3600
}
