@hostname = localhost
@port = 8082
@host = http://{{hostname}}:{{port}}
@contentType = application/json
@authorization = Basic admin:admin


### Create alias
POST {{host}}/url
Content-Type: {{contentType}}
Authorization: {{authorization}}

{
  "URL": "https://github.com/messenger91/go_url_shortener"
}

### Get alias and redirect to url
GET http://localhost:8082/STXHK2